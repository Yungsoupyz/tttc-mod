  "license": "MIT",
  "icon": "assets/tungnesium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.tungnesium.TungnesiumClient"]
  },
  "mixins": ["tungnesium.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": "*"
  }
}
